<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">
	<name>com_pluggen</name>
	<author>Herman Peeren</author>
	<creationDate>2026-09</creationDate>
	<copyright>(C) 2026 Herman Peeren</copyright>
	<license>GNU General Public License version 3 or later; see LICENSE.txt</license>
	<authorUrl>https://yepr.nl</authorUrl>
	<version>0.4.4</version>
	<description>COM_PLUGGEN_XML_DESCRIPTION</description>
	<namespace path="src">Yepr\Component\Pluggen</namespace>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>

	<!--
		Schema updates. The path is relative to the administrator folder of the
		installed component; Joomla runs every file newer than the schema version
		the site records, so a fresh install runs none of them.
	-->
	<update>
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>

	<administration>
		<menu link="option=com_pluggen" img="class:default">com_pluggen</menu>
		<files folder="administrator/components/com_pluggen">
			<filename>access.xml</filename>
			<filename>config.xml</filename>
			<folder>forms</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>
		<languages folder="administrator/components/com_pluggen">
			<language tag="en-GB">language/en-GB/com_pluggen.ini</language>
			<language tag="en-GB">language/en-GB/com_pluggen.sys.ini</language>
		</languages>
	</administration>

	<!--
		The update server. A static file in the repository, served raw by GitHub
		and regenerated from this manifest by build/update-xml.php, so the
		version it advertises cannot drift from the version released.
	-->
	<updateservers>
		<server type="extension" name="Plug-gen" priority="1">https://raw.githubusercontent.com/HermanPeeren/plug-gen/main/updates.xml</server>
	</updateservers>

	<!--
		The site folder exists in the repository layout but carries no files yet.
		Declaring an empty folder makes the installer copy nothing and report a
		missing source, so the block is written out here rather than left to be
		re-derived:

		<files folder="components/com_pluggen">
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>

		It goes before <administration>, as a child of <extension>.
	-->

	<media destination="com_pluggen" folder="media/com_pluggen">
		<folder>css</folder>
		<folder>js</folder>
		<filename>joomla.asset.json</filename>
	</media>
</extension>
