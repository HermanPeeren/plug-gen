<?xml version="1.0" encoding="utf-8"?>
<!--
	The general form: everything that is the same for every plugin type.

	The type-specific fieldsets are appended at runtime by BlueprintModel::getForm()
	from the registered type bundles, and shown with showon="plugin_type:<id>".
-->
<form>
	<field name="id" type="number" label="JGLOBAL_FIELD_ID_LABEL" default="0" class="readonly" readonly="true"/>

	<field
		name="name"
		type="text"
		label="COM_PLUGGEN_FIELD_NAME_LABEL"
		description="COM_PLUGGEN_FIELD_NAME_DESC"
		size="40"
		required="true"
		/>

	<!--
		The plugin type. There is deliberately no separate "group" field: a
		Joomla plugin group and a generator type map one to one today, so asking
		twice only creates a way for the two answers to disagree. The stored
		model still carries plugin.group, derived from the chosen type.

		This list is replaced at runtime with every known group; the ones that
		have no type bundle are rendered disabled rather than hidden.
	-->
	<field
		name="plugin_type"
		type="list"
		label="COM_PLUGGEN_FIELD_TYPE_LABEL"
		description="COM_PLUGGEN_FIELD_TYPE_DESC"
		required="true"
		validate="options"
		>
		<option value="finder">Finder (Smart Search)</option>
	</field>

	<field
		name="target"
		type="list"
		label="COM_PLUGGEN_FIELD_TARGET_LABEL"
		description="COM_PLUGGEN_FIELD_TARGET_DESC"
		default="joomla-6.0"
		validate="options"
		>
		<option value="joomla-6.0">Joomla 6</option>
		<option value="joomla-5.0">Joomla 5</option>
	</field>

	<!--
		The system name is one lowercase word, because it has to serve at once as
		a folder name, the plugin element, the tail of every language key and,
		capitalised, the class name. The class name and the full namespace are
		derived from it and from the group, so the form does not ask: a value the
		user could set wrong is a value that can disagree with the one Joomla
		will look for.
	-->
	<field
		name="system_name"
		type="text"
		label="COM_PLUGGEN_FIELD_SYSTEM_NAME_LABEL"
		description="COM_PLUGGEN_FIELD_SYSTEM_NAME_DESC"
		hint="recipes"
		required="true"
		/>

	<field
		name="org_namespace"
		type="text"
		label="COM_PLUGGEN_FIELD_ORG_NAMESPACE_LABEL"
		description="COM_PLUGGEN_FIELD_ORG_NAMESPACE_DESC"
		hint="Acme"
		required="true"
		/>

	<field
		name="version"
		type="text"
		label="COM_PLUGGEN_FIELD_VERSION_LABEL"
		default="1.0.0"
		required="true"
		/>

	<field
		name="description"
		type="textarea"
		label="COM_PLUGGEN_FIELD_DESCRIPTION_LABEL"
		rows="3"
		/>

	<field
		name="author_name"
		type="text"
		label="COM_PLUGGEN_FIELD_AUTHOR_NAME_LABEL"
		/>

	<field
		name="author_email"
		type="email"
		label="COM_PLUGGEN_FIELD_AUTHOR_EMAIL_LABEL"
		validate="email"
		/>

	<field
		name="author_url"
		type="url"
		label="COM_PLUGGEN_FIELD_AUTHOR_URL_LABEL"
		validate="url"
		relative="false"
		/>

	<field
		name="copyright"
		type="text"
		label="COM_PLUGGEN_FIELD_COPYRIGHT_LABEL"
		/>

	<field
		name="autoloadLanguage"
		type="radio"
		layout="joomla.form.field.radio.switcher"
		label="COM_PLUGGEN_FIELD_AUTOLOADLANGUAGE_LABEL"
		description="COM_PLUGGEN_FIELD_AUTOLOADLANGUAGE_DESC"
		default="1"
		filter="integer"
		>
		<option value="0">JNO</option>
		<option value="1">JYES</option>
	</field>

	<field
		name="services"
		type="checkboxes"
		label="COM_PLUGGEN_FIELD_SERVICES_LABEL"
		description="COM_PLUGGEN_FIELD_SERVICES_DESC"
		default="application,database"
		>
		<option value="application">COM_PLUGGEN_SERVICE_APPLICATION</option>
		<option value="database">COM_PLUGGEN_SERVICE_DATABASE</option>
		<option value="dispatcher">COM_PLUGGEN_SERVICE_DISPATCHER</option>
		<option value="mailerFactory">COM_PLUGGEN_SERVICE_MAILERFACTORY</option>
		<option value="userFactory">COM_PLUGGEN_SERVICE_USERFACTORY</option>
	</field>

	<field
		name="custom_services"
		type="subform"
		label="COM_PLUGGEN_FIELD_CUSTOM_SERVICES_LABEL"
		description="COM_PLUGGEN_FIELD_CUSTOM_SERVICES_DESC"
		multiple="true"
		layout="joomla.form.field.subform.repeatable-table"
		>
		<form>
			<field
				name="name"
				type="text"
				label="COM_PLUGGEN_FIELD_CUSTOM_SERVICE_NAME_LABEL"
				description="COM_PLUGGEN_FIELD_CUSTOM_SERVICE_NAME_DESC"
				hint="cacheControllerFactory"
				/>
			<field
				name="use"
				type="text"
				label="COM_PLUGGEN_FIELD_CUSTOM_SERVICE_USE_LABEL"
				description="COM_PLUGGEN_FIELD_CUSTOM_SERVICE_USE_DESC"
				hint="Joomla\CMS\Cache\CacheControllerFactoryInterface"
				/>
			<field
				name="expression"
				type="text"
				label="COM_PLUGGEN_FIELD_CUSTOM_SERVICE_EXPRESSION_LABEL"
				description="COM_PLUGGEN_FIELD_CUSTOM_SERVICE_EXPRESSION_DESC"
				hint="$container->get(CacheControllerFactoryInterface::class)"
				/>
		</form>
	</field>

	<field
		name="params"
		type="subform"
		label="COM_PLUGGEN_FIELD_PARAMS_LABEL"
		description="COM_PLUGGEN_FIELD_PARAMS_DESC"
		multiple="true"
		layout="joomla.form.field.subform.repeatable-table"
		>
		<form>
			<field name="name" type="text" label="COM_PLUGGEN_FIELD_PARAM_NAME_LABEL" hint="search_archived"/>
			<field name="type" type="text" label="COM_PLUGGEN_FIELD_PARAM_TYPE_LABEL" default="text"/>
			<field name="label" type="text" label="COM_PLUGGEN_FIELD_PARAM_LABEL_LABEL"/>
			<field name="default" type="text" label="COM_PLUGGEN_FIELD_PARAM_DEFAULT_LABEL"/>
		</form>
	</field>

	<field name="model" type="hidden" filter="raw"/>
	<field name="published" type="hidden" filter="integer" default="1"/>
	<field name="created" type="hidden" filter="unset"/>
	<field name="created_by" type="hidden" filter="unset"/>
	<field name="modified" type="hidden" filter="unset"/>
	<field name="modified_by" type="hidden" filter="unset"/>
	<field name="checked_out" type="hidden" filter="unset"/>
	<field name="checked_out_time" type="hidden" filter="unset"/>
</form>
