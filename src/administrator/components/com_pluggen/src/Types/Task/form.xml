<?xml version="1.0" encoding="utf-8"?>
<!--
	The type-specific part of the form for task plugins.

	Each of the two blocks is a single non-repeating subform carrying
	showon="plugin_type:task". The component loads every registered type's form
	into one form, and the browser then shows only the block belonging to the
	selected type - one wrapper per type rather than a showon on every field, so
	a tab holds one visible block however many types are installed.

	A subform posts its children as config_task[<name>] / slots_task[<name>], which
	is the grouping ModelMapper reads, so the data shape is unchanged.

	Field names map onto type.config.<name> in the model.

	No field here carries required="true". Joomla validates the whole form in the
	browser, including fields that showon has hidden, so a required field
	belonging to one plugin type would refuse to let any other type be saved.
	What a type needs is checked by its Definition::validate() instead, which is
	the single source of truth and reports a proper message. A blueprint may be
	saved half-finished; generating it is what demands a complete model.
-->
<form>
	<field
		name="config_task"
		type="subform"
		label="COM_PLUGGEN_TYPE_TASK_FIELDSET"
		showon="plugin_type:task"
		>
		<form>
			<field
				name="routines"
				type="subform"
				label="COM_PLUGGEN_TASK_FIELD_ROUTINES_LABEL"
				description="COM_PLUGGEN_TASK_FIELD_ROUTINES_DESC"
				multiple="true"
				layout="joomla.form.field.subform.repeatable"
				>
				<form>
					<field
						name="id"
						type="text"
						label="COM_PLUGGEN_TASK_FIELD_ROUTINE_ID_LABEL"
						description="COM_PLUGGEN_TASK_FIELD_ROUTINE_ID_DESC"
						hint="recipes.cleanup"
						/>

					<field
						name="method"
						type="text"
						label="COM_PLUGGEN_TASK_FIELD_ROUTINE_METHOD_LABEL"
						description="COM_PLUGGEN_TASK_FIELD_ROUTINE_METHOD_DESC"
						hint="cleanUp"
						/>

					<field
						name="label"
						type="text"
						label="COM_PLUGGEN_TASK_FIELD_ROUTINE_LABEL_LABEL"
						description="COM_PLUGGEN_TASK_FIELD_ROUTINE_LABEL_DESC"
						/>

					<field
						name="description"
						type="text"
						label="COM_PLUGGEN_TASK_FIELD_ROUTINE_DESCRIPTION_LABEL"
						/>

					<field
						name="code"
						type="textarea"
						label="COM_PLUGGEN_TASK_FIELD_ROUTINE_CODE_LABEL"
						description="COM_PLUGGEN_TASK_FIELD_ROUTINE_CODE_DESC"
						rows="8"
						class="code"
						/>

					<field
						name="params"
						type="subform"
						label="COM_PLUGGEN_TASK_FIELD_ROUTINE_PARAMS_LABEL"
						description="COM_PLUGGEN_TASK_FIELD_ROUTINE_PARAMS_DESC"
						multiple="true"
						layout="joomla.form.field.subform.repeatable-table"
						>
						<form>
							<field
								name="name"
								type="text"
								label="COM_PLUGGEN_TASK_FIELD_PARAM_NAME_LABEL"
								hint="max_items"
								/>
							<field
								name="type"
								type="text"
								label="COM_PLUGGEN_TASK_FIELD_PARAM_TYPE_LABEL"
								default="text"
								/>
							<field
								name="label"
								type="text"
								label="COM_PLUGGEN_TASK_FIELD_PARAM_LABEL_LABEL"
								/>
							<field
								name="default"
								type="text"
								label="COM_PLUGGEN_TASK_FIELD_PARAM_DEFAULT_LABEL"
								/>
					</form>
				</field>
			</form>
		</field>
	</form>
	</field>

	<!--
		Plugin-wide open spots. A routine's own body is not here: it belongs to
		the routine, so it is a field of the routine above.
	-->
	<field
		name="slots_task"
		type="subform"
		label="COM_PLUGGEN_TYPE_TASK_SLOTS"
		showon="plugin_type:task"
		>
		<form>
			<field
				name="task_class_members"
				type="textarea"
				label="COM_PLUGGEN_TASK_SLOT_CLASS_MEMBERS_LABEL"
				description="COM_PLUGGEN_TASK_SLOT_CLASS_MEMBERS_DESC"
				rows="6"
				class="code"
				/>
			<field
				name="task_constructor"
				type="textarea"
				label="COM_PLUGGEN_TASK_SLOT_CONSTRUCTOR_LABEL"
				description="COM_PLUGGEN_TASK_SLOT_CONSTRUCTOR_DESC"
				rows="4"
				class="code"
				/>
	</form>
	</field>
</form>
