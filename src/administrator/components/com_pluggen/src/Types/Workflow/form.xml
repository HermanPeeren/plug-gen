<?xml version="1.0" encoding="utf-8"?>
<!--
	The type-specific part of the form for workflow plugins.

	Each of the two blocks is a single non-repeating subform carrying
	showon="plugin_type:workflow". The component loads every registered type's form
	into one form, and the browser then shows only the block belonging to the
	selected type - one wrapper per type rather than a showon on every field, so
	a tab holds one visible block however many types are installed.

	A subform posts its children as config_workflow[<name>] / slots_workflow[<name>], which
	is the grouping ModelMapper reads, so the data shape is unchanged.

	Field names map onto type.config.<name> in the model.

	No field here carries required="true". Joomla validates the whole form in the
	browser, including fields that showon has hidden, so a required field
	belonging to one plugin type would refuse to let any other type be saved.
	What a type needs is checked by its Definition::validate() instead, which is
	the single source of truth and reports a proper message. A blueprint may be
	saved half-finished; generating it is what demands a complete model.
-->
<form>
	<field
		name="config_workflow"
		type="subform"
		label="COM_PLUGGEN_TYPE_WORKFLOW_FIELDSET"
		showon="plugin_type:workflow"
		>
		<form>
			<field
				name="contexts"
				type="textarea"
				label="COM_PLUGGEN_WORKFLOW_FIELD_CONTEXTS_LABEL"
				description="COM_PLUGGEN_WORKFLOW_FIELD_CONTEXTS_DESC"
				hint="com_content.article"
				rows="3"
				/>

			<field
				name="supportFunctionality"
				type="text"
				label="COM_PLUGGEN_WORKFLOW_FIELD_FUNCTIONALITY_LABEL"
				description="COM_PLUGGEN_WORKFLOW_FIELD_FUNCTIONALITY_DESC"
				hint="core.state"
				/>

			<field
				name="fieldsetName"
				type="text"
				label="COM_PLUGGEN_WORKFLOW_FIELD_FIELDSETNAME_LABEL"
				description="COM_PLUGGEN_WORKFLOW_FIELD_FIELDSETNAME_DESC"
				default="actions"
				/>

			<field
				name="fieldsetLabel"
				type="text"
				label="COM_PLUGGEN_WORKFLOW_FIELD_FIELDSETLABEL_LABEL"
				default="COM_WORKFLOW_TRANSITION_ACTIONS_LABEL"
				/>

			<field
				name="handleBeforeTransition"
				type="radio"
				layout="joomla.form.field.radio.switcher"
				label="COM_PLUGGEN_WORKFLOW_FIELD_HANDLEBEFORE_LABEL"
				description="COM_PLUGGEN_WORKFLOW_FIELD_HANDLEBEFORE_DESC"
				default="0"
				filter="integer"
				>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>

			<field
				name="actions"
				type="subform"
				label="COM_PLUGGEN_WORKFLOW_FIELD_ACTIONS_LABEL"
				description="COM_PLUGGEN_WORKFLOW_FIELD_ACTIONS_DESC"
				multiple="true"
				layout="joomla.form.field.subform.repeatable-table"
				>
				<form>
					<field
						name="name"
						type="text"
						label="COM_PLUGGEN_WORKFLOW_FIELD_ACTION_NAME_LABEL"
						hint="notify_author"
						/>
					<field
						name="type"
						type="text"
						label="COM_PLUGGEN_WORKFLOW_FIELD_ACTION_TYPE_LABEL"
						default="text"
						/>
					<field
						name="label"
						type="text"
						label="COM_PLUGGEN_WORKFLOW_FIELD_ACTION_LABEL_LABEL"
						/>
					<field
						name="description"
						type="text"
						label="COM_PLUGGEN_WORKFLOW_FIELD_ACTION_DESCRIPTION_LABEL"
						/>
					<field
						name="default"
						type="text"
						label="COM_PLUGGEN_WORKFLOW_FIELD_ACTION_DEFAULT_LABEL"
						/>
			</form>
		</field>
	</form>
	</field>

	<field
		name="slots_workflow"
		type="subform"
		label="COM_PLUGGEN_TYPE_WORKFLOW_SLOTS"
		showon="plugin_type:workflow"
		>
		<form>
			<field
				name="workflow_class_members"
				type="textarea"
				label="COM_PLUGGEN_WORKFLOW_SLOT_CLASS_MEMBERS_LABEL"
				rows="4"
				class="code"
				/>
			<field
				name="workflow_issupported"
				type="textarea"
				label="COM_PLUGGEN_WORKFLOW_SLOT_ISSUPPORTED_LABEL"
				description="COM_PLUGGEN_WORKFLOW_SLOT_ISSUPPORTED_DESC"
				rows="4"
				class="code"
				/>
			<field
				name="workflow_before"
				type="textarea"
				label="COM_PLUGGEN_WORKFLOW_SLOT_BEFORE_LABEL"
				description="COM_PLUGGEN_WORKFLOW_SLOT_BEFORE_DESC"
				rows="6"
				class="code"
				/>
			<field
				name="workflow_after"
				type="textarea"
				label="COM_PLUGGEN_WORKFLOW_SLOT_AFTER_LABEL"
				description="COM_PLUGGEN_WORKFLOW_SLOT_AFTER_DESC"
				rows="8"
				class="code"
				/>
	</form>
	</field>
</form>
