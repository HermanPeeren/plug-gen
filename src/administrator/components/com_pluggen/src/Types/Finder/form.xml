<?xml version="1.0" encoding="utf-8"?>
<!--
	The type-specific part of the form for finder plugins.

	Each of the two blocks is a single non-repeating subform carrying
	showon="plugin_type:finder". The component loads every registered type's form
	into one form, and the browser then shows only the block belonging to the
	selected type - one wrapper per type rather than a showon on every field, so
	a tab holds one visible block however many types are installed.

	A subform posts its children as config_finder[<name>] / slots_finder[<name>], which
	is the grouping ModelMapper reads, so the data shape is unchanged.

	Field names map onto type.config.<name> in the model.

	No field here carries required="true". Joomla validates the whole form in the
	browser, including fields that showon has hidden, so a required field
	belonging to one plugin type would refuse to let any other type be saved.
	What a type needs is checked by its Definition::validate() instead, which is
	the single source of truth and reports a proper message. A blueprint may be
	saved half-finished; generating it is what demands a complete model.
-->
<form>
	<field
		name="config_finder"
		type="subform"
		label="COM_PLUGGEN_TYPE_FINDER_FIELDSET"
		showon="plugin_type:finder"
		>
		<form>
			<field
				name="context"
				type="text"
				label="COM_PLUGGEN_FINDER_FIELD_CONTEXT_LABEL"
				description="COM_PLUGGEN_FINDER_FIELD_CONTEXT_DESC"
				/>

			<field
				name="extension"
				type="text"
				label="COM_PLUGGEN_FINDER_FIELD_EXTENSION_LABEL"
				description="COM_PLUGGEN_FINDER_FIELD_EXTENSION_DESC"
				hint="com_recipes"
				/>

			<field
				name="itemName"
				type="text"
				label="COM_PLUGGEN_FINDER_FIELD_ITEMNAME_LABEL"
				description="COM_PLUGGEN_FINDER_FIELD_ITEMNAME_DESC"
				hint="recipe"
				/>

			<field
				name="table"
				type="text"
				label="COM_PLUGGEN_FINDER_FIELD_TABLE_LABEL"
				hint="#__recipes"
				/>

			<field
				name="stateField"
				type="text"
				label="COM_PLUGGEN_FINDER_FIELD_STATEFIELD_LABEL"
				description="COM_PLUGGEN_FINDER_FIELD_STATEFIELD_DESC"
				default="state"
				/>

			<field
				name="layout"
				type="text"
				label="COM_PLUGGEN_FINDER_FIELD_LAYOUT_LABEL"
				description="COM_PLUGGEN_FINDER_FIELD_LAYOUT_DESC"
				/>

			<field
				name="typeTitle"
				type="text"
				label="COM_PLUGGEN_FINDER_FIELD_TYPETITLE_LABEL"
				/>

			<field
				name="hasCategories"
				type="radio"
				layout="joomla.form.field.radio.switcher"
				label="COM_PLUGGEN_FINDER_FIELD_HASCATEGORIES_LABEL"
				description="COM_PLUGGEN_FINDER_FIELD_HASCATEGORIES_DESC"
				default="0"
				filter="integer"
				>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>

			<field
				name="taxonomies"
				type="list"
				label="COM_PLUGGEN_FINDER_FIELD_TAXONOMIES_LABEL"
				multiple="true"
				default="Type,Language"
				>
				<option value="Type">COM_PLUGGEN_FINDER_TAXONOMY_TYPE</option>
				<option value="Language">COM_PLUGGEN_FINDER_TAXONOMY_LANGUAGE</option>
				<option value="Author">COM_PLUGGEN_FINDER_TAXONOMY_AUTHOR</option>
				<option value="Category">COM_PLUGGEN_FINDER_TAXONOMY_CATEGORY</option>
			</field>

			<field
				name="columns"
				type="subform"
				label="COM_PLUGGEN_FINDER_FIELD_COLUMNS_LABEL"
				description="COM_PLUGGEN_FINDER_FIELD_COLUMNS_DESC"
				multiple="true"
				layout="joomla.form.field.subform.repeatable-table"
				>
				<form>
					<field
						name="column"
						type="text"
						label="COM_PLUGGEN_FINDER_FIELD_COLUMN_LABEL"
						hint="a.description"
						/>
					<field
						name="alias"
						type="text"
						label="COM_PLUGGEN_FINDER_FIELD_ALIAS_LABEL"
						hint="summary"
						/>
			</form>
		</field>
	</form>
	</field>

	<!--
		The open spots. One textarea per slot declared in type.json; the field
		name is the slot id with dots replaced by underscores. Code typed here is
		stored in the model and injected into the matching protected region, so it
		survives regeneration either way.
	-->
	<field
		name="slots_finder"
		type="subform"
		label="COM_PLUGGEN_TYPE_FINDER_SLOTS"
		showon="plugin_type:finder"
		>
		<form>
			<field
				name="finder_setup"
				type="textarea"
				label="COM_PLUGGEN_FINDER_SLOT_SETUP_LABEL"
				rows="4"
				class="code"
				/>
			<field
				name="finder_index_before"
				type="textarea"
				label="COM_PLUGGEN_FINDER_SLOT_INDEX_BEFORE_LABEL"
				rows="4"
				class="code"
				/>
			<field
				name="finder_index_elements"
				type="textarea"
				label="COM_PLUGGEN_FINDER_SLOT_INDEX_ELEMENTS_LABEL"
				description="COM_PLUGGEN_FINDER_SLOT_INDEX_ELEMENTS_DESC"
				rows="6"
				class="code"
				/>
			<field
				name="finder_index_taxonomies"
				type="textarea"
				label="COM_PLUGGEN_FINDER_SLOT_INDEX_TAXONOMIES_LABEL"
				rows="4"
				class="code"
				/>
			<field
				name="finder_listquery"
				type="textarea"
				label="COM_PLUGGEN_FINDER_SLOT_LISTQUERY_LABEL"
				rows="4"
				class="code"
				/>
	</form>
	</field>
</form>
