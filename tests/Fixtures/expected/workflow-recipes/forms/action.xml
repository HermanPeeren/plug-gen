				name="target_category"
				type="text"
				label="PLG_WORKFLOW_RECIPES_TRANSITION_ACTIONS_TARGET_CATEGORY_LABEL"
				description="PLG_WORKFLOW_RECIPES_TRANSITION_ACTIONS_TARGET_CATEGORY_DESC"
				default=""
				/>
			<field
				name="notify_author"
				type="radio"
				label="PLG_WORKFLOW_RECIPES_TRANSITION_ACTIONS_NOTIFY_AUTHOR_LABEL"
				layout="joomla.form.field.radio.switcher"
				default="0"
