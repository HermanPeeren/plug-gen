{
	"name": "yepr/pluggen",
	"description": "Joomla component that generates Joomla plugins from a saved model",
	"type": "joomla-component",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.0"
	},
	"autoload-dev": {
		"psr-4": {
			"Yepr\\Component\\Pluggen\\Administrator\\": "src/admin/src/",
			"Yepr\\Component\\Pluggen\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"build": "php build/build.php"
	},
	"config": {
		"sort-packages": true
	}
}
