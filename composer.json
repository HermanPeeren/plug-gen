{
	"name": "yepr/pluggen",
	"description": "Joomla component that generates Joomla plugins from a saved model",
	"type": "joomla-component",
	"license": "GPL-3.0-or-later",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.0",
		"phpstan/phpstan": "^2.0",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpunit/phpunit": "^11.0",
		"squizlabs/php_codesniffer": "^3.0"
	},
	"autoload-dev": {
		"psr-4": {
			"Yepr\\Component\\Pluggen\\Administrator\\": "src/admin/src/",
			"Yepr\\Component\\Pluggen\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"build": "php build/build.php",
		"analyse": "phpstan analyse",
		"cs": "phpcs",
		"cs-fix": "php-cs-fixer fix",
		"cs-fix-dry": "php-cs-fixer fix --dry-run --diff"
	},
	"config": {
		"sort-packages": true
	}
}
