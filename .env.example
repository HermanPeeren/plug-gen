# Copy to .env and fill in. The .env file is git-ignored: it holds credentials
# for a local development site and must never be committed.
#
# These are read by the install script (build/install-site.php) and by Cypress
# through cypress.config.js.

# Database the test site runs on
DB_TYPE=mysqli
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=joomla-pluggen
DB_PREFIX=jpg_

# Where the site is installed and reachable
SITE_PATH=joomla
SITE_URL=http://localhost/pluggen-test/joomla
SITE_NAME="Plug-gen test site"

# The Super User the install creates
ADMIN_NAME="Administrator"
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
